generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Eğer prisma.config.ts kullanıyorsan bu satırı KALDIR:
  url      = env("DATABASE_URL")
}

model AuditLog {
  id String @id @default(cuid())

  tenantId String?
  userId   String?

  action   String
  entity   String
  entityId String?

  oldValue Json?
  newValue Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model AuthSession {
  token     String   @id // ✅ cookie’de taşıyacağımız token
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DriverCapability {
  id String @id @default(cuid())

  userId       String
  capabilityId String

  createdAt DateTime @default(now())

  @@index([userId])
}

model DriverLocation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  lat Float
  lng Float

  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model DriverOffer {
  id       String @id @default(cuid())
  jobId    String
  driverId String

  status OfferStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?   // ← FAZ15

  job    Job  @relation(fields: [jobId], references: [id])
  driver User @relation(fields: [driverId], references: [id])

  @@unique([jobId, driverId])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Job {
  id       String @id @default(cuid())
  tenantId String

  offers DriverOffer[]

  source JobSource @default(CLIENT_APP)

  title       String
  description String?

  type JobType

  status JobStatus @default(CREATED)

  requiredCapabilityId String?
  requiredCapability   JobCapability? @relation(fields: [requiredCapabilityId], references: [id])

  priority Int @default(0)

  assignedDriverId String?
  assignedDriver   User?   @relation("AssignedDriver", fields: [assignedDriverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments JobAssignment[]
  events      JobEvent[]
  location    JobLocation?

  queue JobQueue[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, source])
}

model JobAssignment {
  id String @id @default(cuid())

  jobId  String
  userId String

  status AssignmentStatus @default(PENDING)

  createdAt DateTime @default(now())

  assignedAt DateTime  @default(now())
  acceptedAt DateTime?

  job  Job  @relation(fields: [jobId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@index([jobId])
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  TIMEOUT
}

model JobCapability {
  id String @id @default(cuid())

  code     String @unique
  name     String
  category String

  jobs Job[]
}

model JobEvent {
  id String @id @default(cuid())

  jobId String
  type  String

  payload Json?

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model JobLocation {
  id String @id @default(cuid())

  jobId String

  lat Float
  lng Float

  address String?

  job Job @relation(fields: [jobId], references: [id])

  @@unique([jobId])
}

enum JobSource {
  CLIENT_APP
  ADMIN_PANEL
  API
  SYSTEM
}

enum JobStatus {
  CREATED
  OPEN
  ASSIGNING
  ASSIGNED
  ACCEPTED
  ON_THE_WAY
  STARTED
  COMPLETED
  CANCELLED
}

enum JobType {
  DELIVERY
  SERVICE
  VALET
  TOW
  TAXI
}

model JobQueue {
  id String @id @default(cuid())

  jobId  String
  status QueueStatus @default(WAITING)

  attempts Int @default(0)

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([status])
}

enum QueueStatus {
  WAITING
  DISPATCHING
  ASSIGNED
  EXPIRED
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleBindings RoleBinding[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Order {
  id           String      @id @default(cuid())
  tenantId     String
  source       OrderSource @default(INTERNAL)
  externalCode String? // marketplace order code etc.
  status       OrderStatus @default(CREATED)

  currency String @default("TRY")
  subtotal Int    @default(0) // kuruş
  total    Int    @default(0) // kuruş

  customerName  String?
  customerPhone String?
  addressLine   String?
  addressNote   String?

  // future-proof "READY" ihtiyacı
  readyAt DateTime?
  meta    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
}

model OrderEvent {
  id      String @id @default(cuid())
  orderId String

  type     String // e.g. "ORDER_CREATED", "STATUS_CHANGED"
  provider String? // e.g. "INTERNAL", "TRENDYOL"
  payload  Json?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId String? // snapshot-first: opsiyonel
  name      String
  unitPrice Int
  quantity  Int
  lineTotal Int

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum OrderSource {
  INTERNAL
  MARKETPLACE
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // "orders.read" gibi
  desc      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String
  key       String // "ADMIN", "OPS" vs
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  roleBindings RoleBinding[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model RoleBinding {
  id           String @id @default(cuid())
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  roles       Role[]
  Order       Order[]

  auditLogs AuditLog[]
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  password String?

  driverLocation DriverLocation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers DriverOffer[]

  memberships Membership[]
  sessions    AuthSession[]
  auditLogs   AuditLog[]

  assignments JobAssignment[]

  assignedJobs Job[] @relation("AssignedDriver")
}
