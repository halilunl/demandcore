generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Eğer prisma.config.ts kullanıyorsan bu satırı KALDIR:
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  roles       Role[]
  Order       Order[]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String?  @unique
  password  String // ✅ minimal auth için required olsun
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  sessions    AuthSession[]
}

model Order {
  id           String      @id @default(cuid())
  tenantId     String
  source       OrderSource @default(INTERNAL)
  externalCode String? // marketplace order code etc.
  status       OrderStatus @default(CREATED)

  currency String @default("TRY")
  subtotal Int    @default(0) // kuruş
  total    Int    @default(0) // kuruş

  customerName  String?
  customerPhone String?
  addressLine   String?
  addressNote   String?

  // future-proof "READY" ihtiyacı
  readyAt DateTime?
  meta    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId String? // snapshot-first: opsiyonel
  name      String
  unitPrice Int
  quantity  Int
  lineTotal Int

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderEvent {
  id      String @id @default(cuid())
  orderId String

  type     String // e.g. "ORDER_CREATED", "STATUS_CHANGED"
  provider String? // e.g. "INTERNAL", "TRENDYOL"
  payload  Json?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model AuthSession {
  token     String   @id // ✅ cookie’de taşıyacağımız token
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Membership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleBindings RoleBinding[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String
  key       String // "ADMIN", "OPS" vs
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  roleBindings RoleBinding[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // "orders.read" gibi
  desc      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RoleBinding {
  id           String @id @default(cuid())
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
}

enum OrderSource {
  INTERNAL
  MARKETPLACE
}

enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}
